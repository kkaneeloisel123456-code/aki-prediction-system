{
  "name": "AKI Prediction (FastAPI + Vue 3)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Vue.volar"
      ]
    }
  },
  "postCreateCommand": "pip install --user -r backend/requirements.txt && (cd frontend && npm install && npm run build)",
  "postAttachCommand": {
    "server": "uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "API + Web",
      "onAutoForward": "openPreview"
    },
    "5173": {
      "label": "Frontend dev (npm run dev)",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [8000, 5173]
}
